# Production Environment Configuration
# Copy this file to .env.production on your server and update values

# Core Settings
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://yourdomain.com","http://your-server-ip"]

# Database Credentials
POSTGRES_USER=pothole_admin
POSTGRES_PASSWORD=Use_A_Strong_Random_Password_Here
POSTGRES_DB=pothole_prod_db

# File Storage
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# SMTP Email Service (for sending automated reports to authorities)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=reports@okdriver.org
