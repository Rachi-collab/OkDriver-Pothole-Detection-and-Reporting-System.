# Database
DATABASE_URL=postgresql://pothole_user:changeme@localhost:5432/pothole_db

# App
SECRET_KEY=change-this-to-a-long-random-string
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
REPORT_FROM_EMAIL=noreply@okdriver.in

# Upload storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
